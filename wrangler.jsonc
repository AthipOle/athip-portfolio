{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "athip-saenpakdee-portfolio",
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  }
}